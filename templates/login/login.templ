package login

import "sifeucr/templates"

templ Login(action, email, message string, resume bool, tr func(string) string) {
	<section>
		if resume {
			<div class="card" aria-busy="true" role="status">{ tr("web.resuming") }</div>
			<form id="session-restore" hidden method="post" action={ action } data-auto-resume data-signals="{pending:'',error:'',notice:'',failure:'restore failed',errorForm:'',refreshSessions:false}" data-init={ "(async () => { if (document.prerendering) {document.addEventListener('prerenderingchange',()=>location.reload(),{once:true});} else if (!navigator.locks) {location.replace(el.getAttribute('action')+'?resume=0');} else { await " + templates.Submit + "; if ($error) location.replace(el.getAttribute('action')+'?resume=0'); } })()" }>
				<input type="hidden" name="action" value="resume"/>
			</form>
			<noscript><a href={ action + "?resume=0" }>{ tr("web.login") }</a></noscript>
		}
		<form style="max-width:36rem;margin-inline:auto" onsubmit={ templ.JSUnsafeFuncCall(templates.NativeBusy) } hidden?={ resume } method="post" action={ action }>
			<h1>{ tr("web.login") }</h1>
			<input type="hidden" name="action" value="login"/>
			<label for="login-email">{ tr("web.email") }</label>
			<input id="login-email" type="email" name="email" value={ email } autocomplete="username" required/>
			<label for="login-password">{ tr("web.password") }</label>
			<input id="login-password" type="password" name="password" autocomplete="current-password"/>
			@templates.FormWarning(message)
			<footer><button type="submit">{ tr("web.login") }</button></footer>
		</form>
	</section>
}

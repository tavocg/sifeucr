package home

import "sifeucr/templates"


templ Sessions(action, home, next string, sessions []Session, tr func(string) string, language string) {
	<section data-busy="sessions-refresh" id="sessions" class="card" style="min-width:0" data-refresh={ home + "?fragment=sessions" } data-effect={ "if ($refreshSessions && !$pending) { $refreshSessions = false; document.querySelector('dialog[open]')?.close(); " + templates.Refresh + " }" }>
		<hgroup>
			<header>
				<h3>{ tr("web.sessions") }</h3>
				<div style="display:flex">
					<button id="sessions-refresh" type="button" class="plain" data-refresh={ home + "?fragment=sessions" } data-on:click={ templates.Refresh } { templates.Button()... } aria-label={ tr("web.reload") } title={ tr("web.reload") }>
						<svg data-attr:hidden="$pending === 'sessions-refresh'" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M3 12a9 9 0 0 1 15.36-6.36L21 8M21 3v5h-5M21 12a9 9 0 0 1-15.36 6.36L3 16M3 21v-5h5"></path>
						</svg>
					</button>
					<button type="button" class="plain" commandfor="logout" command="show-modal" aria-label={ tr("web.logout") } title={ tr("web.logout") }>
						<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
							<path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4M16 17l5-5-5-5M21 12H9"></path>
						</svg>
					</button>
				</div>
			</header>
		</hgroup>
		<table class="nowrap">
			<thead><tr><th>{ tr("web.device") }</th><th>{ tr("web.created") }</th><th>{ tr("web.used") }</th><th>{ tr("web.expires") }</th><th></th></tr></thead>
			<tbody>
				for _,session := range sessions {
					<tr>
						<td>
							<div style="display:flex;align-items:center;gap:.5rem">
								@device(session, tr)
							</div>
						</td>
						<td>@timestamp(language, session.Created, false)</td>
						<td>@timestamp(language, session.Used, true)</td>
						<td>@timestamp(language, session.Expires, false)</td>
						<td>
							<a { templates.Link()... } href={ "#revoke-" + session.ID } data-on:click__prevent="document.getElementById(el.getAttribute('aria-controls')).showModal()" aria-haspopup="dialog" aria-controls={ "revoke-" + session.ID }>{ tr("web.logout") }</a>
							@confirmLogout("revoke-"+session.ID, action, "revoke", session.ID, session.Label(tr), session.Current, tr)
						</td>
					</tr>
				}
			</tbody>
		</table>
		if next!="" {
			<a { templates.Link()... } href={ next } data-refresh={ next + "&fragment=sessions" } data-on:click={ "if (!evt.ctrlKey && !evt.metaKey && !evt.shiftKey && !evt.altKey && evt.button === 0) { evt.preventDefault(); " + templates.Refresh + " }" }>{ tr("web.next") }</a>
		}
		@confirmLogout("logout", action, "logout", "", "", true, tr)
	</section>
}

package base

import "sifeucr/routes"

type PageParams struct {
	Nonce string
	Links routes.Links
	Head  HeadParams
	Body  BodyParams
}

templ Page(page PageParams) {
	<!DOCTYPE html>
	{{ attrs := templ.Attributes{}
if page.Nonce != "" {
	attrs["data-nonce"] = page.Nonce
} }}
	<html { attrs... }>
		@head(page.Head, page.Links, page.Nonce != "")
		@body(page.Body, page.Links)
	</html>
}
